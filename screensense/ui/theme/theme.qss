QWidget#breakOverlay {
    background-color: #1e1e1e;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 8px;
}

QLabel#promptTitle {
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 18px;
    font-weight: 600;
}

QWidget#countdownRing {
    background-color: transparent;
    color: #cccccc;
}

QPushButton {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    background-color: #2d2d2d;
    color: #cccccc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #383838;
    color: #ffffff;
}

QPushButton:focus {
    border: 1px solid #007acc;
}

QPushButton#eyeYogaButton {
    border: 1px solid #1177bb;
    background-color: #0e639c;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#eyeYogaButton:hover {
    background-color: #1177bb;
}

QPushButton#eyeYogaButton:focus {
    border: 1px solid #ffffff;
}

QMenu {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    padding: 4px 0;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #04395e;
    color: #ffffff;
}

QDialog,
QDialog#settingsDialog,
QWidget#settingsContent,
QWidget#settingsViewport,
QScrollArea#settingsScrollArea,
QScrollArea#settingsScrollArea > QWidget > QWidget {
    background-color: #1e1e1e;
    color: #cccccc;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QScrollArea#settingsScrollArea {
    border: none;
    background-color: #1e1e1e;
}

QDialog QLabel,
QDialog#settingsDialog QLabel {
    color: #cccccc;
    background: transparent;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

QLabel#settingsSectionHeading {
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    margin-top: 10px;
    margin-bottom: 2px;
}

QLabel#settingsFieldLabel {
    color: #969696;
    font-size: 12px;
}

QLineEdit, QComboBox, QSpinBox, QTimeEdit {
    background-color: #252526;
    color: #ffffff;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 5px 8px;
    font-size: 13px;
    min-height: 22px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTimeEdit:focus {
    border: 1px solid #007acc;
    background-color: #2d2d2d;
    color: #ffffff;
}

QSpinBox::up-button, QSpinBox::down-button,
QTimeEdit::up-button, QTimeEdit::down-button {
    background-color: #333333;
    border: none;
    width: 18px;
}

QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QTimeEdit::up-button:hover, QTimeEdit::down-button:hover {
    background-color: #444444;
}

QSpinBox::up-arrow, QTimeEdit::up-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #cccccc;
}

QSpinBox::down-arrow, QTimeEdit::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #cccccc;
}

QCheckBox {
    color: #cccccc;
    spacing: 8px;
    font-size: 13px;
    background: transparent;
}

QCheckBox:focus {
    outline: 1px solid #007acc;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    background-color: #252526;
}

QCheckBox::indicator:hover {
    border-color: #007acc;
}

QCheckBox::indicator:checked {
    background-color: #0e639c;
    border-color: #1177bb;
}

QScrollBar:vertical {
    background: #1e1e1e;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3c3c3c;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #555555;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    selection-background-color: #04395e;
    selection-color: #ffffff;
}

QPushButton#dayCheckButton {
    min-height: 30px;
    padding: 0 4px;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    background-color: #252526;
    color: #858585;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#dayCheckButton:hover {
    background-color: #2d2d2d;
    color: #cccccc;
}

QPushButton#dayCheckButton:checked {
    background-color: #0e639c;
    border-color: #1177bb;
    color: #ffffff;
    font-weight: 600;
}

QListWidget {
    background-color: #252526;
    color: #cccccc;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px;
    font-size: 13px;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 3px;
}

QListWidget::item:hover {
    background-color: #2a2d2e;
}

QListWidget::item:selected {
    background-color: #04395e;
    color: #ffffff;
}

QPushButton#primaryActionButton {
    min-height: 32px;
    padding: 0 16px;
    border: 1px solid #1177bb;
    border-radius: 4px;
    background-color: #0e639c;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primaryActionButton:hover {
    background-color: #1177bb;
}

QPushButton#secondaryActionButton {
    min-height: 32px;
    padding: 0 14px;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    background-color: #2d2d2d;
    color: #cccccc;
    font-size: 13px;
}

QPushButton#secondaryActionButton:hover {
    background-color: #383838;
    color: #ffffff;
}

QLabel#validationMessage {
    color: #f14c4c;
    font-size: 12px;
}
